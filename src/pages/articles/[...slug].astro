---
import Layout from '../../layouts/Layout.astro';
import Main from '../../components/Main.astro';
import { listArticles, renderArticle } from '../../lib/asciidoc';

export function getStaticPaths() {
  return listArticles().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const article = await renderArticle(slug!);
---
<Layout title={article.title}>
  <Main article>
    <article class="single adoc" itemscope>
      <h1 itemprop="headline">{article.title}</h1>
      {article.date && (
        <small class="meta">
          <time itemprop="datePublished" datetime={article.date}>{article.date}</time>
        </small>
      )}
      <Fragment set:html={article.html} />
    </article>
  </Main>

  {article.hasStem && (
    <Fragment>
      <script is:inline>
        window.MathJax = {
          tex: {
            inlineMath: [['\\(', '\\)']],
            displayMath: [['\\[', '\\]']],
            processEscapes: false,
            tags: 'ams',
          },
          options: { ignoreHtmlClass: 'nostem|nolatexmath' },
        };
      </script>
      <script is:inline async src="https://cdn.jsdelivr.net/npm/mathjax@4.0.0/tex-chtml.js"></script>
    </Fragment>
  )}
</Layout>

<style>
  h1,
  .single :global(h2),
  .single :global(h3) {
    font-family: 'EB Garamond', helvetica, Georgia, serif;
  }

  .meta {
    color: #999;
    font-family: helvetica, arial, sans-serif;
  }

  .adoc :global(#toctitle) {
    font-weight: bold;
  }

  .adoc :global(.stemblock) {
    overflow-x: auto;
  }

  .adoc :global(.listingblock .title) {
    font-style: italic;
  }

  /* Images: Asciidoctor's align= attribute becomes a text-{left,center,right} class. */
  .adoc :global(.imageblock) {
    margin: 1.5em 0;
  }
  .adoc :global(.imageblock img) {
    max-width: 100%;
    height: auto;
  }
  .adoc :global(.imageblock .title) {
    font-style: italic;
    font-size: 0.9em;
  }
  .adoc :global(.text-left) {
    text-align: left;
  }
  .adoc :global(.text-center) {
    text-align: center;
  }
  .adoc :global(.text-right) {
    text-align: right;
  }
  .adoc :global(p),
  .adoc :global(li){
    max-width: 80ch;
    text-wrap: pretty;
    hyphens: auto;
  }

  .adoc :global(p) {
    margin: 0 0 1.1em;
    font-variant-numeric: oldstyle-nums proportional-nums;
  }

  .adoc :global(h2) {
    margin: 2.2em 0 0.6em;
    line-height: 1.2;
    text-wrap: balance;
  }
  .adoc :global(h3) {
    margin: 1.8em 0 0.5em;
    line-height: 1.25;
    text-wrap: balance;
  }

  /* Tables: aligned digits */
  .adoc :global(table) {
    font-variant-numeric: tabular-nums;
  }

  /* Links: keep underlines clear of descenders */
  .adoc :global(a) {
    text-underline-offset: 0.15em;
    text-decoration-thickness: 1px;
  }

  /* Code: monospace runs visually large, so scale it down */
  .adoc :global(:not(pre) > code) {
    font-size: 0.88em;
  }
  .adoc :global(pre) {
    font-size: 0.85em;
    line-height: 1.45;
    overflow-x: auto;
  }
  .adoc :global(pre code) {
    font-size: inherit;
  }

  /* Equations: breathing room to match images */
  .adoc :global(.stemblock) {
    margin: 1.5em 0;
  }
</style>
