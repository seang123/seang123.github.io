---
import Layout from '../../layouts/Layout.astro';
import Main from '../../components/Main.astro';
import { listArticles, renderArticle } from '../../lib/asciidoc';

export function getStaticPaths() {
  return listArticles().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const article = await renderArticle(slug!);
---
<Layout title={article.title}>
  <Main>
    <article class="single adoc" itemscope>
      <h1 itemprop="headline">{article.title}</h1>
      {article.date && (
        <small class="meta">
          <time itemprop="datePublished" datetime={article.date}>{article.date}</time>
        </small>
      )}
      <Fragment set:html={article.html} />
    </article>
  </Main>

  {article.hasStem && (
    <Fragment>
      <script is:inline>
        window.MathJax = {
          tex: {
            inlineMath: [['\\(', '\\)']],
            displayMath: [['\\[', '\\]']],
            processEscapes: false,
            tags: 'ams',
          },
          options: { ignoreHtmlClass: 'nostem|nolatexmath' },
        };
      </script>
      <script is:inline async src="https://cdn.jsdelivr.net/npm/mathjax@4.0.0/tex-chtml.js"></script>
    </Fragment>
  )}
</Layout>

<style>
  h1,
  .single :global(h2),
  .single :global(h3) {
    font-family: 'EB Garamond', helvetica, Georgia, serif;
  }

  .meta {
    color: #999;
    font-family: helvetica, arial, sans-serif;
  }

  .adoc :global(#toctitle) {
    font-weight: bold;
  }

  .adoc :global(.stemblock) {
    overflow-x: auto;
  }

  .adoc :global(.listingblock .title) {
    font-style: italic;
  }
</style>
